# ==============================================================================
# PrepSmart AI - Environment Configuration Template
# Duplicate this file as '.env.local' and supply your personal credentials.
# ==============================================================================

# 1. Supabase Database & Auth (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# 2. Ollama Local AI Engine (Optional - https://ollama.com)
# When running, questions and evaluations will be generated via local Llama 3.3.
# If offline, PrepSmart AI will automatically utilize its calibrated heuristic AI fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.3
NEXT_PUBLIC_OLLAMA_MODEL=llama3.3

# 3. Application Settings
NEXT_PUBLIC_INTERVIEW_QUESTION_COUNT=5
NEXT_PUBLIC_QUESTION_NOTE=Click on Record Answer when you want to answer the question. At the end of the interview we will give you the feedback along with correct answer for each question and your answer to compare it.

# 4. Razorpay Payment Gateway (https://dashboard.razorpay.com)
# Obtain Key ID and Key Secret from Razorpay Dashboard > Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
